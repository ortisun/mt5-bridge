# mt5-bridge configuration for the Windows/UTM guest (copy to config\bridge.env).
# No broker credential belongs here: the terminal credentials are environment
# variables of the Windows user (docs/install-utm.md, step 6). Without the
# terminal variables the bridge attaches to the terminal that is already
# logged in, and boot verifies the account below.
MT5_BRIDGE_CLIENT_BACKEND=real
MT5_BRIDGE_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# IANA zone of the broker server's wall clock when the terminal reports it as
# epochs (proven for Rico-DEMO); leave unset for true-UTC terminals.
MT5_BRIDGE_TERMINAL_TIME_ZONE=America/Sao_Paulo
MT5_BRIDGE_ENVIRONMENT=demo
MT5_BRIDGE_EXPECTED_LOGIN=<demo account number>
MT5_BRIDGE_EXPECTED_SERVER=<demo server, e.g. Broker-DEMO>
MT5_BRIDGE_POSITION_ACCOUNTING=NETTING
MT5_BRIDGE_HOST=<VM address>
MT5_BRIDGE_PORT=8765
MT5_BRIDGE_TLS_CERTFILE=C:\mt5-bridge\tls\bridge-cert.pem
MT5_BRIDGE_TLS_KEYFILE=C:\mt5-bridge\tls\bridge-key.pem
MT5_BRIDGE_DB_PATH=C:\mt5-bridge\data\mt5_bridge.sqlite3
